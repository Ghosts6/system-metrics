# This Dockerfile is for creating a development and testing environment.
# It includes all dependencies, including development tools like pytest.

FROM python:3.10-slim

WORKDIR /app

# Install poetry
RUN pip install poetry

# Install build dependencies for psutil
RUN apt-get clean && apt-get update && \
    for i in $(seq 1 5); do \
        apt-get install -y --no-install-recommends gcc python3-dev && break || sleep 10; \
    done && \
    rm -rf /var/lib/apt/lists/*

# Copy project files
COPY backend/pyproject.toml ./
COPY backend/poetry.lock* ./

# Install ALL dependencies (including dev)
RUN poetry config virtualenvs.create false && \
    poetry install --no-root

# The default command will run the tests
CMD ["pytest"]
